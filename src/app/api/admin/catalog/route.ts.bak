import { NextResponse } from "next/server";
import { query, initDb } from "@/lib/db";
import { requireRole, authErrorResponse } from "@/lib/auth";
import { newAuditId, newProductId } from "@/lib/ids";

export const dynamic = "force-dynamic";

const ADMIN_ONLY = ["Administrator"] as const;

export async function GET() {
  try {
    await requireRole([...ADMIN_ONLY, "Operations Specialist"]);
    await initDb();
    const result = await query(
      `SELECT id, name, description, price, interval, status, variants
       FROM products ORDER BY created_at DESC;`
    );
    return NextResponse.json({ success: true, products: result.rows });
  } catch (err) {
    return authErrorResponse(err);
  }
}

export async function POST(request: Request) {
  try {
    const user = await requireRole([...ADMIN_ONLY]);
    const { name, description, price, interval } = await request.json();

    if (!name || typeof price !== "number" || price < 0) {
      return NextResponse.json(
        { success: false, error: "name and non-negative numeric price required." },
        { status: 400 }
      );
    }
    const intervalEnum = ["Monthly", "Yearly", "Weekly", "Daily"].includes(interval)
      ? interval
      : "Monthly";

    await initDb();
    const id = newProductId();
    const result = await query(
      `INSERT INTO products (id, name, description, price, interval, status, variants)
       VALUES ($1, $2, $3, $4, $5, 'Active', 1)
       RETURNING id, name, description, price, interval, status, variants;`,
      [id, String(name), String(description ?? ""), price, intervalEnum]
    );

    await query(
      `INSERT INTO audit_logs (id, action, actor, area)
       VALUES ($1, $2, $3, 'Catalog');`,
      [newAuditId(), `Created product ${name}`, user.name]
    );

    return NextResponse.json({ success: true, product: result.rows[0] });
  } catch (err) {
    return authErrorResponse(err);
  }
}

export async function PATCH(request: Request) {
  try {
    const user = await requireRole([...ADMIN_ONLY]);
    const { id, status } = await request.json();

    if (!id || !["Active", "Archived"].includes(status)) {
      return NextResponse.json(
        { success: false, error: "id and status (Active|Archived) required." },
        { status: 400 }
      );
    }

    await initDb();
    const result = await query(
      "UPDATE products SET status = $1 WHERE id = $2 RETURNING id, name, status;",
      [status, id]
    );
    if (result.rows.length === 0) {
      return NextResponse.json(
        { success: false, error: "Product not found" },
        { status: 404 }
      );
    }

    const prod = result.rows[0];
    await query(
      `INSERT INTO audit_logs (id, action, actor, area)
       VALUES ($1, $2, $3, 'Catalog');`,
      [
        newAuditId(),
        `${status === "Active" ? "Activated" : "Archived"} ${prod.name}`,
        user.name,
      ]
    );
    return NextResponse.json({ success: true, product: prod });
  } catch (err) {
    return authErrorResponse(err);
  }
}

export async function DELETE(request: Request) {
  try {
    const user = await requireRole([...ADMIN_ONLY]);
    const id = new URL(request.url).searchParams.get("id");
    if (!id) {
      return NextResponse.json(
        { success: false, error: "id required." },
        { status: 400 }
      );
    }

    await initDb();
    const result = await query(
      "DELETE FROM products WHERE id = $1 RETURNING id, name;",
      [id]
    );
    if (result.rows.length === 0) {
      return NextResponse.json(
        { success: false, error: "Product not found" },
        { status: 404 }
      );
    }

    const prod = result.rows[0];
    await query(
      `INSERT INTO audit_logs (id, action, actor, area)
       VALUES ($1, $2, $3, 'Catalog');`,
      [newAuditId(), `Deleted product ${prod.name}`, user.name]
    );
    return NextResponse.json({ success: true, deleted: prod });
  } catch (err) {
    return authErrorResponse(err);
  }
}