import { NextResponse } from "next/server";
import { query, initDb } from "@/lib/db";
import { requireRole, authErrorResponse } from "@/lib/auth";
import { newAuditId, newCustomerId } from "@/lib/ids";

export const dynamic = "force-dynamic";

const READERS = ["Administrator", "Operations Specialist"] as const;
const WRITERS = ["Administrator"] as const;

export async function GET() {
  try {
    await requireRole([...READERS]);
    await initDb();
    const result = await query(
      `SELECT id, company, name, email, phone, city,
              tax_id AS "taxId", status,
              active_contracts AS "activeContracts",
              total_spend AS "totalSpend"
       FROM customers
       ORDER BY created_at DESC;`
    );
    return NextResponse.json({ success: true, customers: result.rows });
  } catch (err) {
    return authErrorResponse(err);
  }
}

export async function POST(request: Request) {
  try {
    const user = await requireRole([...WRITERS]);
    const { company, name, email, phone, city, taxId } = await request.json();

    if (!company || !name || !email) {
      return NextResponse.json(
        { success: false, error: "company, name, email required." },
        { status: 400 }
      );
    }

    await initDb();
    const id = newCustomerId();
    const result = await query(
      `INSERT INTO customers
        (id, company, name, email, phone, city, tax_id, status, active_contracts, total_spend)
       VALUES ($1, $2, $3, $4, $5, $6, $7, 'Onboarding', 0, 0)
       RETURNING id, company, name, email, phone, city,
                 tax_id AS "taxId", status,
                 active_contracts AS "activeContracts",
                 total_spend AS "totalSpend";`,
      [
        id,
        String(company),
        String(name),
        String(email),
        phone || "+91 98000 00000",
        city || "Bangalore",
        taxId || "29AABC00000A1Z0",
      ]
    );

    await query(
      `INSERT INTO audit_logs (id, action, actor, area)
       VALUES ($1, $2, $3, 'Customer records');`,
      [newAuditId(), `Registered customer record for ${company}`, user.name]
    );

    return NextResponse.json({ success: true, customer: result.rows[0] });
  } catch (err) {
    return authErrorResponse(err);
  }
}

export async function DELETE(request: Request) {
  try {
    const user = await requireRole([...WRITERS]);
    const id = new URL(request.url).searchParams.get("id");
    if (!id) {
      return NextResponse.json(
        { success: false, error: "id required." },
        { status: 400 }
      );
    }

    await initDb();
    const result = await query(
      "DELETE FROM customers WHERE id = $1 RETURNING id, company;",
      [id]
    );
    if (result.rows.length === 0) {
      return NextResponse.json(
        { success: false, error: "Customer not found." },
        { status: 404 }
      );
    }

    const item = result.rows[0];
    await query(
      `INSERT INTO audit_logs (id, action, actor, area)
       VALUES ($1, $2, $3, 'Customer records');`,
      [newAuditId(), `Deleted customer record for ${item.company}`, user.name]
    );

    return NextResponse.json({ success: true, deleted: item });
  } catch (err) {
    return authErrorResponse(err);
  }
}