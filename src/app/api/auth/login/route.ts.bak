import { NextResponse } from "next/server";
import { query, initDb } from "@/lib/db";
import { attachSession, type SessionUser } from "@/lib/auth";
import { hashPassword, isHashed, verifyPassword } from "@/lib/crypto";

export const dynamic = "force-dynamic";

function safeRedirectFor(
  role: string,
  candidate: string | null | undefined
): string {
  const defaultForRole =
    role === "Administrator"
      ? "/admin"
      : role === "Customer"
        ? "/dashboard"
        : "/staff";

  if (!candidate) return defaultForRole;
  if (!candidate.startsWith("/") || candidate.startsWith("//")) {
    return defaultForRole;
  }

  const allowed =
    candidate.startsWith("/admin")
      ? role === "Administrator"
      : candidate.startsWith("/staff")
        ? role !== "Customer"
        : candidate.startsWith("/dashboard")
          ? true
          : false;

  return allowed ? candidate : defaultForRole;
}

export async function POST(request: Request) {
  let email = "";
  let password = "";
  let nextParam: string | null = null;

  try {
    const body = await request.json();
    email = String(body.email ?? "").trim().toLowerCase();
    password = String(body.password ?? "");
    nextParam = typeof body.next === "string" ? body.next : null;
  } catch {
    return NextResponse.json(
      { success: false, error: "Malformed JSON body" },
      { status: 400 }
    );
  }

  if (!email || !password) {
    return NextResponse.json(
      { success: false, error: "Email and password are required." },
      { status: 400 }
    );
  }

  try {
    await initDb();

    const res = await query<{
      id: string;
      name: string;
      email: string;
      password: string;
      role: string;
      status: string;
      permissions: string | null;
    }>(
      "SELECT id, name, email, password, role, status, permissions FROM users WHERE LOWER(email) = $1 LIMIT 1;",
      [email]
    );

    if (res.rows.length === 0) {
      return NextResponse.json(
        { success: false, error: "Invalid email or password." },
        { status: 401 }
      );
    }

    const row = res.rows[0];

    if (row.status !== "Active") {
      return NextResponse.json(
        { success: false, error: "This account is not active." },
        { status: 403 }
      );
    }

    if (!verifyPassword(password, row.password)) {
      return NextResponse.json(
        { success: false, error: "Invalid email or password." },
        { status: 401 }
      );
    }

    if (!isHashed(row.password)) {
      await query("UPDATE users SET password = $1 WHERE id = $2;", [
        hashPassword(password),
        row.id,
      ]);
    }

    const user: SessionUser = {
      id: row.id,
      name: row.name,
      email: row.email,
      role: row.role as SessionUser["role"],
      permissions: row.permissions ?? "",
    };

    const redirect = safeRedirectFor(user.role, nextParam);

    return attachSession(
      NextResponse.json({ success: true, redirect, user }),
      user
    );
  } catch (err: any) {
    console.error("[login]", err);
    return NextResponse.json(
      { success: false, error: "Login service unavailable." },
      { status: 500 }
    );
  }
}