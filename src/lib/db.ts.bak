           ('USR-STAFF-01', 'Siddharth Rao', $1, $2, 'Operations Specialist', 'Active',
            'Customer records, Subscriptions & Quotes, Invoices & Billing'),
           ('USR-STAFF-02', 'Maya Joseph', 'maya.joseph@payloop.internal', $2,
